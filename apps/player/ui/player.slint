import { ClockView } from "../../../screens/clock/ui/clock.slint";
import { UsageView } from "../../../screens/usage/ui/usage.slint";
import { PortfolioView } from "../../../screens/portfolio/ui/portfolio.slint";
import { PreviewControls } from "preview.slint";

export component PlayerWindow inherits Window {
    in property <bool> preview: true;
    in property <length> viewport-width: 800px;
    in property <length> viewport-height: 480px;
    in property <string> clock-time;
    in property <bool> portfolio-mode;
    in property <string> portfolio-amount;
    in property <int> portfolio-amount-length;
    in property <string> portfolio-currency;
    in property <string> portfolio-message;
    in property <bool> usage-mode;
    in property <float> five-hour;
    in property <float> weekly;
    in property <string> usage-message;
    in property <bool> ansi-mode;
    in property <image> ansi-frame;
    in property <bool> paused;
    in property <string> status;
    callback previous();
    callback toggle-pause();
    callback next();

    title: root.preview ? "Pi Display | Screen preview" : "Pi Display";
    background: #000000;
    width: root.viewport-width;
    height: root.viewport-height + (root.preview ? 48px : 0px);

    if !root.ansi-mode && !root.usage-mode && !root.portfolio-mode: ClockView {
        x: 0px;
        y: 0px;
        width: parent.width;
        height: root.preview ? root.viewport-height : parent.height;
        time: root.clock-time;
    }

    if !root.ansi-mode && root.portfolio-mode: PortfolioView {
        x: 0px;
        y: 0px;
        width: parent.width;
        height: root.preview ? root.viewport-height : parent.height;
        amount: root.portfolio-amount;
        amount-length: root.portfolio-amount-length;
        currency: root.portfolio-currency;
        message: root.portfolio-message;
    }

    if !root.ansi-mode && root.usage-mode: UsageView {
        x: 0px;
        y: 0px;
        width: parent.width;
        height: root.preview ? root.viewport-height : parent.height;
        five-hour: root.five-hour;
        weekly: root.weekly;
        message: root.usage-message;
    }

    if root.ansi-mode: Image {
        x: 0px;
        y: 0px;
        width: parent.width;
        height: root.preview ? root.viewport-height : parent.height;
        source: root.ansi-frame;
        image-fit: contain;
        image-rendering: pixelated;
    }

    if root.preview: PreviewControls {
        y: root.viewport-height;
        width: parent.width;
        height: 48px;
        paused: root.paused;
        status: root.status;
        previous => { root.previous(); }
        toggle-pause => { root.toggle-pause(); }
        next => { root.next(); }
    }
}
