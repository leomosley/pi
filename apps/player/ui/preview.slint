import { Button, Palette } from "std-widgets.slint";

export component PreviewControls inherits Rectangle {
    in property <bool> paused;
    in property <string> status;
    callback previous();
    callback toggle-pause();
    callback next();
    background: Palette.background;

    HorizontalLayout {
        padding: 6px;
        spacing: 6px;
        Button { text: "Previous"; clicked => { root.previous(); } }
        Button { text: root.paused ? "Resume" : "Pause"; clicked => { root.toggle-pause(); } }
        Button { text: "Next"; clicked => { root.next(); } }
        Text {
            text: root.status;
            color: Palette.foreground;
            font-size: 12px;
            horizontal-alignment: right;
            vertical-alignment: center;
            horizontal-stretch: 1;
            overflow: elide;
        }
    }
}
