{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": { "dependsOn": ["^build"], "cache": false },
    "test": { "dependsOn": ["^build"], "cache": false },
    "lint": { "cache": false },
    "dev": {
      "cache": false,
      "persistent": true,
      "passThroughEnv": [
        "DISPLAY",
        "WAYLAND_DISPLAY",
        "XDG_RUNTIME_DIR",
        "XAUTHORITY",
        "DBUS_SESSION_BUS_ADDRESS",
        "SLINT_BACKEND",
        "WINIT_UNIX_BACKEND",
        "TRADING212_API_KEY",
        "TRADING212_API_SECRET",
        "TRADING_212_KEY_ID",
        "TRADING_212_SECRET",
        "PI_USAGE_RELAY_KEY"
      ]
    }
  }
}
