component UsageBar inherits Rectangle {
    in property <string> label;
    in property <float> percent: -1;
    background: #000;
    Text {
        text: root.label;
        color: #fff;
        font-size: 20px;
        font-family: "monospace";
        height: 28px;
    }
    Text {
        text: root.percent < 0 ? "--" : round(root.percent) + "% used";
        color: #fff;
        font-size: 20px;
        font-family: "monospace";
        horizontal-alignment: right;
        height: 28px;
    }
    Rectangle {
        y: 40px;
        height: 24px;
        width: parent.width;
        border-width: 1px;
        border-color: #fff;
        background: #000;
        Rectangle {
            x: 3px;
            y: 3px;
            height: parent.height - 6px;
            width: (parent.width - 6px) * max(0, root.percent) / 100;
            background: #fff;
        }
    }
}

export component UsageView inherits Rectangle {
    in property <float> five-hour: -1;
    in property <float> weekly: -1;
    in property <string> message;
    background: #000;
    UsageBar {
        x: 32px;
        y: parent.height / 2 - 92px;
        width: parent.width - 64px;
        height: 64px;
        label: "5-hour";
        percent: root.five-hour;
    }
    UsageBar {
        x: 32px;
        y: parent.height / 2 + 16px;
        width: parent.width - 64px;
        height: 64px;
        label: "Weekly";
        percent: root.weekly;
    }
    Text {
        y: parent.height - 40px;
        height: 32px;
        text: root.message;
        color: #aaa;
        font-size: 12px;
        horizontal-alignment: center;
        wrap: word-wrap;
    }
}
