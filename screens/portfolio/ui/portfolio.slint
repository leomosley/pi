import { RefreshIndicator } from "../../../crates/screen-widgets/ui/refresh-indicator.slint";

export component PortfolioView inherits Rectangle {
    in property <string> amount;
    in property <int> amount-length: 10;
    in property <int> refresh-mask;
    in property <string> message;
    background: #000;
    Text {
        width: parent.width;
        height: parent.height;
        text: root.amount;
        color: #fff;
        font-family: "DejaVu Sans Mono";
        font-size: min((root.width - 32px) / max(6, root.amount-length), root.height / 4);
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    Text {
        y: parent.height - 64px;
        height: 32px;
        width: parent.width;
        text: root.message;
        color: #aaa;
        font-size: 12px;
        horizontal-alignment: center;
        wrap: word-wrap;
    }

    RefreshIndicator {
        x: parent.width - self.width - 8px;
        y: parent.height - self.height - 8px;
        mask: root.refresh-mask;
    }
}
